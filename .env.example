# ---------------------------------------------------------------------------
# vantage-ingest — environment template.
#
# Copy the values you need into your Cloudflare Worker as SECRETS, not files:
#
#   npx wrangler secret put DATABASE_URL
#   npx wrangler secret put INCO_API_KEY
#   ...and so on.
#
# `wrangler secret put` writes the value to Cloudflare's encrypted secret store.
# This file is a REFERENCE ONLY and is safe to commit — it must never contain a
# real key. Real `.env` files are git-ignored (see .gitignore); only this
# template is tracked.
#
# Non-secret tunables (USER_AGENT, DEFAULT_POLL_INTERVAL_MINUTES, the
# CLASSIFIER_* knobs and model ids) live in wrangler.toml under [vars]. Override
# them there, or set them as Worker secrets/env if you prefer. They are shown
# here so you can see them all in one place.
# ---------------------------------------------------------------------------

# --- Required: database -----------------------------------------------------
# Neon pooled connection string, including sslmode=require. Treat as a secret.
DATABASE_URL="postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Required: inference provider (signal layer) ----------------------------
# API key for the OpenAI-compatible inference host at https://api.inco.ai/v1.
# Treat as a secret. Required only when CLASSIFIER_ENABLED is not "false".
INCO_API_KEY="sk-replace-me"

# --- Signal layer: model ids (non-secret; defaults shown) -------------------
# Model ids verified against GET https://api.inco.ai/v1/models on 2026-10-07.
INCO_CLASSIFIER_MODEL="deepseek-v4.1-flash"
# Writer model id. Reserved seam for the planned drafting phase; unused today.
INCO_WRITER_MODEL="kimi-k3"

# --- Signal layer: behaviour (non-secret; defaults shown) -------------------
# Master switch. Set to "false" to disable ALL LLM work (no keys needed).
CLASSIFIER_ENABLED="true"
# Items per LLM call.
CLASSIFIER_BATCH_SIZE="15"
# Hard cap on items classified per queue message (cost guardrail).
CLASSIFIER_MAX_ITEMS_PER_MESSAGE="60"
# Max concurrent in-flight LLM calls within one message.
CLASSIFIER_MAX_CONCURRENCY="2"

# --- Signal layer: Grok X scanner (non-secret; defaults shown) --------------
# A 4-hourly scan of X for NEW signals about tracked entities, feeding the SAME
# ingest pipeline via the `ingest-signal` seam (no separate DB path). OFF by
# default: set SCANNER_ENABLED="true" AND INCO_SCANNER_MODEL to a real id.
# Kill switch.
SCANNER_ENABLED="false"
# The X-scanning model id on the inference host. PLACEHOLDER — set the real id.
INCO_SCANNER_MODEL="replace-with-grok-x-scanner-model"
# Comma-separated tracked entities/products (competitors + your own product).
SCANNER_TRACKED_ENTITIES="Cursor,GitHub Copilot,Claude Code,OpenAI Codex,Windsurf,Cline,Aider,Devin,Replit,Google Gemini,LangChain"
# Comma-separated tracked themes/keywords.
SCANNER_TRACKED_KEYWORDS="AI coding agent,AI code review,developer tool launch,funding round,new model release"
# Hard cap on signals enqueued per scan (cost guardrail).
SCANNER_MAX_ITEMS_PER_SCAN="25"

# --- Optional: source-specific tuning ---------------------------------------
# Descriptive User-Agent REQUIRED by SEC EDGAR (source fails without it).
# Example: "GTM-Monitor/0.1 (you@example.com)"
EDGAR_USER_AGENT="GTM-Monitor/0.1 (you@example.com)"
# Optional Stack Exchange API key: raises the shared quota from 300/day to 10k/day.
STACKEXCHANGE_KEY=""
# Bearer token required by POST /trigger/:sourceId and POST /signals/:sourceId.
# Treat as a secret; set it or those endpoints stay closed.
MANUAL_TRIGGER_TOKEN="replace-with-a-long-random-string"
# User-Agent sent for all ordinary feeds.
USER_AGENT="GTM-Monitor/0.1 (+https://example.com/gtm-monitor; ingestion bot)"
# Fallback poll interval (minutes). Declared in wrangler.toml; per-source
# intervals in src/registry/seed.ts take precedence in practice.
DEFAULT_POLL_INTERVAL_MINUTES="20"

# --- Queue names (declared in wrangler.toml; listed here for reference) -----
# These are Cloudflare bindings, not env vars you set by hand. Creating the
# queues is a one-time step:
#   npx wrangler queues create gtm-ingest-jobs
#   npx wrangler queues create gtm-ingest-jobs-dlq
#   npx wrangler queues create gtm-classify-jobs
#   npx wrangler queues create gtm-classify-jobs-dlq
INGEST_QUEUE_NAME="gtm-ingest-jobs"
INGEST_DLQ_NAME="gtm-ingest-jobs-dlq"
CLASSIFY_QUEUE_NAME="gtm-classify-jobs"
CLASSIFY_DLQ_NAME="gtm-classify-jobs-dlq"
